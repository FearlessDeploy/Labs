# ==============================================================================
# Global .gitignore for Kubernetes Laboratories Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# Python (FastAPI, Django, Flask, uv, poetry, pip)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Django Artifacts
*.sqlite3
db.sqlite3
media/
staticfiles/

# ------------------------------------------------------------------------------
# Java (Maven & Gradle, Spring Boot)
# ------------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle build directory & cache
.gradle/
build/
bin/
out/

# ------------------------------------------------------------------------------
# Node.js, Frontend (React, Vite, Angular, Tailwind)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
/dist/
dist/
dist-ssr/
out-tsc/
bazel-out/
.angular/
.next/
.nuxt/
.vuepress/dist
.temp/
.cache/

# ------------------------------------------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
.history/
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Sublime / Atom / Editors
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# Operating System & Logs
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
